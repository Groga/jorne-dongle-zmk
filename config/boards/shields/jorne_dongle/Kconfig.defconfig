# =============================================================================
# Kconfig.defconfig — jorne_dongle
#
# Версия: 1.0.0
# Автор:  Evgeniy Moskovkin
#
# Назначение:
#   Донгл — это ОТДЕЛЬНОЕ физическое устройство на nRF52840 (без клавиш),
#   которое вставляется в USB компьютера и является центральным узлом (ZMK
#   central). Обе половинки Jorne при этом собираются как периферия (BLE
#   peripheral) и просто передают сырые события клавиш на донгл.
#
#   Плюсы схемы "донгл":
#     - обе половинки клавиатуры экономят батарею (не держат BLE-соединение
#       с хостом, только короткий линк с донглом)
#     - удобно на ноутбуках со слабым/капризным встроенным BLE
#     - можно быстро "перезалить" донгл под другой хост без перепрошивки
#       самой клавиатуры
# =============================================================================
if SHIELD_JORNE_DONGLE

# Имя устройства, которое увидит хост при сопряжении по Bluetooth
config ZMK_KEYBOARD_NAME
    default "Jorne"

# Этот узел — split-клавиатура
config ZMK_SPLIT
    default y

# Ключевая настройка: именно ДОНГЛ, а не половинка, является центром
config ZMK_SPLIT_ROLE_CENTRAL
    default y

# Донгл принимает 2 периферии: левую и правую половинки
config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

# BT_MAX_CONN = периферии (2) + желаемое число профилей хоста (по умолчанию 5)
config BT_MAX_CONN
    default 7

# Должно совпадать с BT_MAX_CONN
config BT_MAX_PAIRED
    default 7

# Донгл обычно питается от USB хоста постоянно — держим USB-логику включённой
config ZMK_USB
    default y

# У донгла нет своей батареи/датчика заряда — отключаем отчёт по батарее
config ZMK_BATTERY_REPORTING
    default n

endif # SHIELD_JORNE_DONGLE
